# 🔟 Concept: Implement Async/Await Using Generator

```js
function asyncWrapper(generatorFn) {
  return function () {
    const gen = generatorFn();

    function step(nextFn, arg) {
      let next;
      try {
        next = nextFn.call(gen, arg);
      } catch (err) {
        return Promise.reject(err);
      }

      if (next.done) {
        return Promise.resolve(next.value);
      }

      return Promise.resolve(next.value)
        .then(v => step(gen.next, v))
        .catch(e => step(gen.throw, e));
    }

    return step(gen.next);
  };
}
```

